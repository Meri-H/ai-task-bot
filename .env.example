# Copy to .env and fill in. Only TELEGRAM_BOT_TOKEN is required.

# --- Telegram (create a bot with @BotFather) --------------------------------------------
TELEGRAM_BOT_TOKEN=
# Optional: comma-separated Telegram user ids allowed to use the bot (empty = everyone)
TELEGRAM_ALLOWED_USER_IDS=
# Shown in the bot's /start message
DASHBOARD_URL=http://localhost:3000

# --- Voice transcription ------------------------------------------------------------------
# local runs on your CPU without paid API calls. auto may use OpenAI if a key is set.
TRANSCRIPTION_PROVIDER=local
OPENAI_API_KEY=
# If OpenAI is down/over quota, fall back to the local model
TRANSCRIPTION_FALLBACK_TO_LOCAL=false
# Local model size: tiny | base | small | medium (bigger = slower, more accurate)
WHISPER_LOCAL_MODEL=base
# Optional language hint, e.g. en. Empty = auto-detect
TRANSCRIPTION_LANGUAGE=
MAX_VOICE_SECONDS=120
# One CPU transcription at a time avoids contention; notifications have a separate worker.
WORKER_CONCURRENCY=1
NOTIFICATION_WORKER_CONCURRENCY=4

# --- Dashboard ----------------------------------------------------------------------------
DASHBOARD_PORT=3000
# If set, the dashboard asks for this token (recommended outside localhost)
DASHBOARD_TOKEN=

# --- Infrastructure -----------------------------------------------------------------------
POSTGRES_PASSWORD=your_postgres_password
LOG_LEVEL=INFO
